FROM python:3.11 AS stage1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python train_and_export_model.py

FROM python:3.11 AS stage2
WORKDIR /app

COPY requirements_stage2.txt .
RUN pip install --no-cache-dir -r requirements_stage2.txt

COPY --from=stage1 /app/predictor_app.py .
COPY --from=stage1 /app/data/model.joblib data/model.joblib

CMD ["uvicorn", "predictor_app:app", "--host", "0.0.0.0", "--port", "8000"]

